monitors = c("theta_amy", "f_val_amy", "f_pred_amy", "r_pred_amy", "row_idx_amy", "gamma_amy", "alpha",
"theta_tau", "f_val_tau", "f_pred_tau","r_pred_tau", "row_idx_tau", "gamma_tau", "xg",
"gamma_d", "gamma_weib", "shape_weib", "sigma_y_amy", "sigma_a_amy", "sigma_y_tau", "sigma_a_tau", "rho"),
niter = 5000,
nburnin = 3000,
thin = 1,
nchains = 1,
fullres = TRUE) # fullres fixed
save(res, file = paste0("E:/Github/data/model_out",cv,".Rdata"))
}
#library(nimbleHMC)
mcchains <- function(
varying_coef_code,
simudata,
monitors = c("theta", "beta_pred", "r_pred", "f_pred", "y_pred", "row_idx", "idx","safe_idx", "idx_bound",
"dd", "gamma_r", "alpha_i", "xg", "f_val", "sigma_a", "sigma_y"),
niter = 200,
nburnin = 100,
thin = 5,
nchains = 1,
fullres = TRUE){
s1 <- Sys.time()
model <- nimbleModel(varying_coef_code,
constants = simudata$constants,
data = simudata$data,
check = FALSE, calculate = FALSE,
inits = simudata$inits)
#model$initializeInfo()
## ---- mcmc ----
cModel <- compileNimble(model)
conf <- configureMCMC(model)
conf$addMonitors(monitors)
conf$removeSampler("theta_amy")
conf$removeSampler("theta_tau")
conf$removeSampler("gamma_amy")
conf$removeSampler("gamma_tau")
conf$removeSampler("gamma_weib")
conf$removeSampler("alpha")
conf$removeSampler("rho")
conf$removeSampler("sigma_a_tau")
conf$removeSampler("sigma_a_amy")
conf$addSampler(target = c("gamma_amy[1:5]", "gamma_tau[1:5]", 'rho'), type = 'AF_slice')
conf$addSampler(target = c("sigma_a_amy", "sigma_a_tau"), type = 'AF_slice')
conf$addSampler(target = c("theta_amy[1:10]"), type = 'AF_slice')
conf$addSampler(target = c("theta_tau[1:10]"), type = 'AF_slice')
conf$addSampler(target = c("gamma_weib[1:6]"), type = 'AF_slice')
for(n in 1:1520) {
conf$addSampler(target = paste0('alpha[1:2, ', n, ']'),
type = 'AF_slice')
}
mcmc <- buildMCMC(conf)
cMCMC <- compileNimble(mcmc, project = model)
samples <- runMCMC(cMCMC, niter = niter, nburnin = nburnin, thin = thin, nchains = nchains)
s2 <- Sys.time()
#samples <- runMCMC(cMCMC, niter = 500, nburnin = 0, thin = 5, nchains = 4)
## ---- storage ----
if(fullres == T){
return(list(samples = samples,
time = as.numeric(s2-s1),
mcmc = mcmc,
conf = conf,
cMCMC = cMCMC
))
}else{
conf$addMonitors(c("theta", "beta_pred","r_pred", "f_pred", "y_pred","sigma_y", "f_val", "bp", "lambda"))
# \\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\
# return()
}
}
## 5 fold cv
for(cv in 1:5){
test_id  <- fold_list[[cv]]
train_id <- sort(as.numeric(unlist(fold_list[-cv])))
simudata_cv <- realdata_cv(X_amy, X_tau, train_id, simudata$constants$tau_amy_link, dta_surv_df)
save(simudata_cv, file = paste0("E:/Github/data/real_data_cv",cv,".Rdata"))
# Constraints
max_t_tau <- rep(NA, simudata_cv$constants$n_subjects_amy)
min_t_tau <- rep(NA, simudata_cv$constants$n_subjects_amy)
max_t_tau[simudata_cv$constants$tau_amy_link] <- simudata_cv$constants$max_t_tau
min_t_tau[simudata_cv$constants$tau_amy_link] <- simudata_cv$constants$min_t_tau
max_t_tau[-simudata_cv$constants$tau_amy_link] <- 0
min_t_tau[-simudata_cv$constants$tau_amy_link] <- 140
simudata_cv$constants$max_t_tau <- max_t_tau
simudata_cv$constants$min_t_tau <- min_t_tau
simudata_cv$data$constraint_alpha_tau <- simudata_cv$data$constraint_alpha_amy
# Alpha inits
simudata_cv$inits$alpha <- matrix(NA, nrow = 2, ncol = simudata_cv$constants$n_subjects_amy)
simudata_cv$inits$alpha[1, ] <- simudata_cv$inits$alpha_amy
simudata_cv$inits$alpha[2, simudata_cv$constants$tau_amy_link] <- simudata_cv$inits$alpha_tau
simudata_cv$inits$alpha[2, -simudata_cv$constants$tau_amy_link] <- simudata_cv$inits$alpha_amy[-simudata_cv$constants$tau_amy_link]
# Survival inits
# Needed?
# Run model
res <- mcchains(varying_coef_code,
simudata_cv,
monitors = c("theta_amy", "f_val_amy", "f_pred_amy", "r_pred_amy", "row_idx_amy", "gamma_amy", "alpha",
"theta_tau", "f_val_tau", "f_pred_tau","r_pred_tau", "row_idx_tau", "gamma_tau", "xg",
"gamma_d", "gamma_weib", "shape_weib", "sigma_y_amy", "sigma_a_amy", "sigma_y_tau", "sigma_a_tau", "rho"),
niter = 5000,
nburnin = 3000,
thin = 1,
nchains = 1,
fullres = TRUE) # fullres fixed
save(res, file = paste0("E:/Github/data/model_out",cv,".Rdata"))
}
